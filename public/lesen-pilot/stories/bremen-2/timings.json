7},{"t":"seinem","a":53652,"b":53968},{"t":"Flügel","a":53982,"b":54614}]},{"id":"ankunft","index":5,"startMs":56284,"endMs":65944,"text":"Am Nachmittag ist der Zug in Bremen. Der Bahnhof ist groß und voll. Die Freunde staunen.","words":[{"t":"Am","a":56391,"b":56563},{"t":"Nachmittag","a":56578,"b":57225},{"t":"ist","a":57239,"b":57411},{"t":"der","a":57426,"b":57598},{"t":"Zug","a":57613,"b":57929},{"t":"in","a":57943,"b":58072},{"t":"Bremen","a":58087,"b":58676},{"t":"Der","a":60225,"b":60383},{"t":"Bahnhof","a":60398,"b":60886},{"t":"ist","a":60901,"b":61131},{"t":"groß","a":61145,"b":61490},{"t":"und","a":61504,"b":61662},{"t":"voll","a":61677,"b":62108},{"t":"Die","a":63675,"b":63819},{"t":"Freunde","a":63834,"b":64265},{"t":"staunen","a":64279,"b":64954}]},{"id":"statue","index":6,"startMs":66594,"endMs":77676,"text":"Auf dem Marktplatz sehen sie eine Statue: einen Esel, einen Hund, eine Katze und einen Hahn. Das sind ja wir, ruft der Hahn.","words":[{"t":"Auf","a":66701,"b":66917},{"t":"dem","a":66931,"b":67118},{"t":"Marktplatz","a":67132,"b":67793},{"t":"sehen","a":67808,"b":68110},{"t":"sie","a":68124,"b":68311},{"t":"eine","a":68325,"b":68541},{"t":"Statue","a":68555,"b":69158},{"t":"einen","a":69446,"b":69791},{"t":"Esel","a":69805,"b":70265},{"t":"einen","a":70394,"b":70638},{"t":"Hund","a":70653,"b":71027},{"t":"eine","a":71242,"b":71486},{"t":"Katze","a":71500,"b":72003},{"t":"und","a":72018,"b":72305},{"t":"einen","a":72319,"b":72578},{"t":"Hahn","a":72592,"b":72994},{"t":"Das","a":74543,"b":74773},{"t":"sind","a":74788,"b":75032},{"t":"ja","a":75046,"b":75204},{"t":"wir","a":75219,"b":75549},{"t":"ruft","a":75722,"b":76024},{"t":"der","a":76038,"b":76196},{"t":"Hahn","a":76210,"b":76670}]}],"durationMs":77676,"wordsCount":131,"matchRate":1.0}},"a2":{"conrad":{"level":"A2","voice":"de-DE-ConradNeural","format":"mp3","approximate":false,"scenes":[{"id":"plakat","index":0,"startMs":0,"endMs":14420,"text":"Eines Morgens bringt der Hahn ein buntes Plaka