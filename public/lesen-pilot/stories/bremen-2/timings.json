b":47173},{"t":"groß","a":47187,"b":47532},{"t":"ist","a":47546,"b":47876},{"t":"bleibt","a":48049,"b":48437},{"t":"er","a":48451,"b":48595},{"t":"am","a":48609,"b":48781},{"t":"Fenster","a":48796,"b":49284},{"t":"stehen","a":49299,"b":49716},{"t":"und","a":49730,"b":49989},{"t":"beobachtet","a":50003,"b":50664},{"t":"die","a":50678,"b":50807},{"t":"Felder","a":50822,"b":51339},{"t":"die","a":51554,"b":51683},{"t":"vorbeiziehen","a":51698,"b":52603}]},{"id":"kontrolle","index":4,"startMs":54256,"endMs":66084,"text":"Bei der Fahrkartenkontrolle sucht der Hahn verzweifelt nach seinem Ticket. Zum Glück findet die Katze es unter seinem Flügel, und der freundliche Schaffner lacht.","words":[{"t":"Bei","a":54363,"b":54564},{"t":"der","a":54579,"b":54751},{"t":"Fahrkartenkontrolle","a":54766,"b":55930},{"t":"sucht","a":55944,"b":56217},{"t":"der","a":56231,"b":56375},{"t":"Hahn","a":56389,"b":56648},{"t":"verzweifelt","a":56662,"b":57438},{"t":"nach","a":57453,"b":57654},{"t":"seinem","a":57668,"b":57970},{"t":"Ticket","a":57984,"b":58516},{"t":"Zum","a":59999,"b":60286},{"t":"Glück","a":60301,"b":60603},{"t":"findet","a":60617,"b":60947},{"t":"die","a":60962,"b":61077},{"t":"Katze","a":61091,"b":61479},{"t":"es","a":61494,"b":61681},{"t":"unter","a":61695,"b":61968},{"t":"seinem","a":61982,"b":62284},{"t":"Flügel","a":62298,"b":62815},{"t":"und","a":63074,"b":63246},{"t":"der","a":63261,"b":63448},{"t":"freundliche","a":63462,"b":64137},{"t":"Schaffner","a":64152,"b":64554},{"t":"lacht","a":64568,"b":65085}]},{"id":"ankunft","index":5,"startMs":66734,"endMs":78010,"text":"Mit etwas Verspätung kommt der Zug am Nachmittag in Bremen an. Der Hauptbahnhof ist riesig, und überall eilen Menschen mit Koffern vorbei.","words":[{"t":"Mit","a":66841,"b":67085},{"t":"etwas","a":67100,"b":67445},{"t":"Verspätung","a":67459,"b":68163},{"t":"kommt","a":68178,"b":68437},{"t":"der","a":68451,"b":68609},{"t":"Zug","a":68623,"b":68968},{"t":"am","a":68982,"b":69126},{"t":"Nachmittag","a":69