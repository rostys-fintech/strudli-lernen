{"a1":{"conrad":{"level":"A1","voice":"de-DE-ConradNeural","format":"mp3","approximate":true,"scenes":[{"id":"esel","index":0,"startMs":0,"endMs":9444,"text":"Ein Esel ist alt und müde. Er will nach Bremen gehen. Dort will er Musik machen.","words":[{"t":"Ein","a":107,"b":380},{"t":"Esel","a":395,"b":740},{"t":"ist","a":754,"b":1013},{"t":"alt","a":1027,"b":1286},{"t":"und","a":1300,"b":1530},{"t":"müde","a":1544,"b":2119},{"t":"Er","a":3701,"b":3902},{"t":"will","a":3917,"b":4118},{"t":"nach","a":4132,"b":4362},{"t":"Bremen","a":4377,"b":4779},{"t":"gehen","a":4793,"b":5253},{"t":"Dort","a":6815,"b":7174},{"t":"will","a":7189,"b":7376},{"t":"er","a":7390,"b":7505},{"t":"Musik","a":7520,"b":7894},{"t":"machen","a":7907,"b":8439}]},{"id":"hund","index":1,"startMs":10094,"endMs":18554,"text":"Auf dem Weg trifft er einen Hund. Der Hund ist auch alt. Er kommt mit.","words":[{"t":"Auf","a":10201,"b":10373},{"t":"dem","a":10393,"b":10693,"estimated":true},{"t":"Weg","a":10713,"b":11013,"estimated":true},{"t":"trifft","a":10862,"b":11250},{"t":"er","a":11265,"b":11423},{"t":"einen","a":11437,"b":11696},{"t":"Hund","a":11710,"b":12155},{"t":"Der","a":13723,"b":13881},{"t":"Hund","a":13896,"b":14198},{"t":"ist","a":14212,"b":14428},{"t":"auch","a":14442,"b":14672},{"t":"alt","a":14686,"b":15117},{"t":"Er","a":16669,"b":16856},{"t":"kommt","a":16871,"b":17187},{"t":"mit","a":17201,"b":17546}]},{"id":"katze","index":2,"startMs":19204,"endMs":27520,"text":"Dann sehen sie eine Katze. Sie ist traurig. Die Katze geht auch mit.","words":[{"t":"Dann","a":19311,"b":19570},{"t":"sehen","a":19584,"b":19871},{"t":"sie","a":19886,"b":20058},{"t":"eine","a":20073,"b":20289},{"t":"Katze","a":20303,"b":20878},{"t":"Sie","a":22425,"b":22641},{"t":"ist","a":22655,"b":22856},{"t":"traurig","a":22871,"b":23532},{"t":"Die","a":25107,"b":25265},{"t":"Katze","a":25280,"b":25682},{"t":"geht","a":25697,"b":25913},{"t":"auch","a":25926,"b":26127},{"t":"mit","a":26142,"b":26516}]},{"id":"hahn","index"