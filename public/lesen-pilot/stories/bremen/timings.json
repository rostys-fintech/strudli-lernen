5206,"text":"Auf einem Bauernhof kräht ein Hahn aus voller Kehle, denn morgen soll er in der Suppe landen. Die Freunde nehmen ihn einfach mit.","words":[{"t":"Auf","a":34973,"b":35289},{"t":"einem","a":35304,"b":35563},{"t":"Bauernhof","a":35577,"b":36195},{"t":"kräht","a":36209,"b":36611},{"t":"ein","a":36626,"b":36784},{"t":"Hahn","a":36798,"b":37071},{"t":"aus","a":37086,"b":37302},{"t":"voller","a":37315,"b":37631},{"t":"Kehle","a":37646,"b":38048},{"t":"denn","a":38336,"b":38552},{"t":"morgen","a":38565,"b":39039},{"t":"soll","a":39054,"b":39298},{"t":"er","a":39313,"b":39457},{"t":"in","a":39471,"b":39586},{"t":"der","a":39600,"b":39772},{"t":"Suppe","a":39787,"b":40060},{"t":"landen","a":40074,"b":40692},{"t":"Die","a":42169,"b":42313},{"t":"Freunde","a":42328,"b":42759},{"t":"nehmen","a":42773,"b":43147},{"t":"ihn","a":43161,"b":43362},{"t":"einfach","a":43376,"b":43807},{"t":"mit","a":43822,"b":44196}]},{"id":"wald","index":4,"startMs":45856,"endMs":56676,"text":"Bremen ist zu weit für einen Tag. Als es dunkel wird, entdecken die vier im Wald ein helles Licht, das aus einem kleinen Haus kommt.","words":[{"t":"Bremen","a":45963,"b":46437},{"t":"ist","a":46452,"b":46668},{"t":"zu","a":46682,"b":46840},{"t":"weit","a":46854,"b":47098},{"t":"für","a":47113,"b":47285},{"t":"einen","a":47300,"b":47587},{"t":"Tag","a":47601,"b":48061},{"t":"Als","a":49559,"b":49889},{"t":"es","a":49904,"b":50048},{"t":"dunkel","a":50062,"b":50464},{"t":"wird","a":50479,"b":50809},{"t":"entdecken","a":51025,"b":51499},{"t":"die","a":51514,"b":51658},{"t":"vier","a":51672,"b":51945},{"t":"im","a":51959,"b":52117},{"t":"Wald","a":52131,"b":52476},{"t":"ein","a":52490,"b":52662},{"t":"helles","a":52677,"b":53036},{"t":"Licht","a":53051,"b":53453},{"t":"das","a":53683,"b":53970},{"t":"aus","a":53985,"b":54172},{"t":"einem","a":54186,"b":54416},{"t":"kleinen","a":54430,"b":54890},{"t":"Haus","a":54904,"b":55191},{"t":"kommt","a":55206,"b":55666}]},{"id":"raeuber","index":5,"startMs":573